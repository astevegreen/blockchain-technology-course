<% 
  function capitalizeWords(str) {
    return str.split(' ').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ');
  }
%>

<ul>
<% for (const item of items) { %>
  <li class="lab_listing">
    <a href="<%- item.path %>">
        <%= capitalizeWords(item.path.split('/').reverse()[1].replace("-"," ").replace("_"," ")) %>
    </a>
  </li>
<% } %>
</ul>