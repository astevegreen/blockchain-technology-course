\mode<presentation>

% Theme Required Packages
\RequirePackage{tikz}
\RequirePackage{xcolor}
\RequirePackage{calc}
% If you didn't add it in the inner theme, add it here:
% \RequirePackage{tcolorbox}

% Color theme and palette
\usecolortheme{aci}

% Font sizes for key elements
\setbeamerfont{title}{series=\bfseries,size=\fontsize{18}{22}}
\setbeamerfont{footline}{size=\fontsize{6}{8}}

% Inner/outer themes
\useinnertheme{aci}
\useoutertheme{aci}

% Misc beamer templates
\setbeamertemplate{items}[circle]
\setbeamertemplate{sections/subsections in toc}[square]
\setbeamertemplate{blocks}[rounded][shadow=true]

\mode<all>
