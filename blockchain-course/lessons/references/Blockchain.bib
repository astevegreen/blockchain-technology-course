@article{zhu_governancetechnologyblockchain_2024,
  title = {The Governance Technology for Blockchain Systems: A Survey},
  shorttitle = {The Governance Technology for Blockchain Systems},
  author = {Zhu, Guocheng and He, Debiao and An, Haoyang and Luo, Min and Peng, Cong},
  date = {2024-04},
  journaltitle = {Frontiers of Computer Science},
  shortjournal = {Front. Comput. Sci.},
  volume = {18},
  number = {2},
  pages = {182813},
  issn = {2095-2228, 2095-2236},
  doi = {10.1007/s11704-023-3113-x},
  url = {https://link.springer.com/10.1007/s11704-023-3113-x},
  urldate = {2025-10-21},
  abstract = {Abstract             After the Ethereum DAO attack in 2016, which resulted in significant economic losses, blockchain governance has become a prominent research area. However, there is a lack of comprehensive and systematic literature review on blockchain governance. To deeply understand the process of blockchain governance and provide guidance for the future design of the blockchain governance model, we provide an in-depth review of blockchain governance. In this paper, first we introduce the consensus algorithms currently used in blockchain and relate them to governance theory. Second, we present the main content of off-chain governance and investigate two well-known off-chain governance projects. Third, we investigate four common on-chain governance voting techniques, then summarize the seven attributes that the on-chain governance voting process should meet, and finally analyze four well-known on-chain governance blockchain projects based on the previous research. We hope this survey will provide an in-depth insight into the potential development direction of blockchain governance and device future research agenda.},
  langid = {english}
}
