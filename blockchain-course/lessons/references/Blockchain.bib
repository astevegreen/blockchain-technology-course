@misc{porat_blockchainconsensusanalysis_2017,
  title = {Blockchain {{Consensus}}: {{An}} Analysis of {{Proof-of-Work}} and Its Applications.},
  author = {Porat, Eylon and Pratap, Suyash and Shah, Parth and Adkar, Karan},
  date = {2017},
