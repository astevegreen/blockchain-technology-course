{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "NO_COLOR": "1",
    "FORCE_COLOR": "0",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "200000"
  },
  "permissions": {
    "allow": [
      "Bash(python tools/*)",
      "Bash(node tools/*)",
      "Bash(node --test *)",
      "Bash(python quizes/*)",
      "Bash(python blockchain-course/glossary/scripts/*)",
      "Bash(quarto render *)",
      "Bash(quarto check *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch *)",
      "Bash(git push)",
      "Bash(git push origin main)"
    ],
    "deny": [
      "Read(**/_site/**)",
      "Read(**/.quarto/**)",
      "Read(**/assets/vendor/**)",
      "Read(**/*_files/mediabag/**)",
      "Read(**/quizes/dist/**)",
      "Read(**/node_modules/**)",
      "Read(**/*.log)",
      "Read(**/.agents/**)",
      "Read(**/glossary/terms.json)",
      "Read(**/glossary/duplicates.md)",
      "Read(**/glossary/index.pdf)",
      "Read(**/.runtime/**)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push *--force*)",
      "Bash(git push * -f*)",
      "Bash(git push *+*)",
      "Bash(git push http*)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git filter-branch *)",
      "Bash(git filter-repo *)",
      "Bash(git remote add *)",
      "Bash(git remote set-url *)",
      "Bash(git remote remove *)",
      "Bash(git remote rename *)",
      "Bash(git branch -D *)",
      "Bash(git tag -d *)",
      "Bash(gh workflow run *)",
      "Bash(gh repo edit *)",
      "Bash(gh repo delete *)",
      "PowerShell(git push *--force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git push *+*)",
      "PowerShell(git push http*)",
      "PowerShell(git reset --hard *)",
      "PowerShell(git clean *)",
      "PowerShell(git filter-branch *)",
      "PowerShell(git filter-repo *)",
      "PowerShell(git remote add *)",
      "PowerShell(git remote set-url *)",
      "PowerShell(git remote remove *)",
      "PowerShell(git remote rename *)",
      "PowerShell(git branch -D *)",
      "PowerShell(git tag -d *)",
      "PowerShell(gh workflow run *)",
      "PowerShell(gh repo edit *)",
      "PowerShell(gh repo delete *)"
    ],
    "ask": [
      "Edit(/.claude/**)",
      "Edit(/CLAUDE.md)",
      "Edit(/.github/**)",
      "Edit(/tools/hooks/**)",
      "Bash(gh secret *)",
      "Bash(gh auth *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/tools/hooks/env-check.mjs"],
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/tools/hooks/handoff-nudge.mjs"],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/tools/hooks/quick-check.mjs"],
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/tools/hooks/gate.mjs"],
            "timeout": 600
          },
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/tools/hooks/handoff-nudge.mjs"],
            "timeout": 15
          }
        ]
      }
    ]
  }
}
