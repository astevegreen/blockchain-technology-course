{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "NO_COLOR": "1",
    "FORCE_COLOR": "0",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "200000"
  },
  "permissions": {
    "allow": [
      "Bash(python tools/*)",
      "Bash(node tools/*)",
      "Bash(node --test *)",
      "Bash(python quizes/*)",
      "Bash(python blockchain-course/glossary/scripts/*)",
      "Bash(quarto render *)",
      "Bash(quarto check *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch *)",
      "Bash(git push)",
      "Bash(git push origin main)"
    ],
    "deny": [
      "Read(**/_site/**)",
      "Read(**/.quarto/**)",
      "Read(**/assets/vendor/**)",
      "Read(**/*_files/mediabag/**)",
      "Read(**/quizes/dist/**)",
      "Read(**/node_modules/**)",
      "Read(**/*.log)",
      "Read(**/.agents/**)",
      "Read(**/glossary/terms.json)",
      "Read(**/glossary/duplicates.md)",
      "Read(**/glossary/index.pdf)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git filter-branch *)"
    ]
  }
}
