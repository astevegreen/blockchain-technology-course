#!/bin/sh
# Git pre-commit hook: every commit, from Claude, Gemini or the owner, passes `python tools/check.py`.
# A working tree that already passed (the Claude Stop hook runs the same check) is not checked again.
# Turn it on once per clone: git config core.hooksPath .githooks
command -v python >/dev/null 2>&1 && PY=python || PY=py
exec "$PY" tools/check.py --stamped
