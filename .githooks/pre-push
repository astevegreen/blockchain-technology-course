#!/bin/sh
# Sprint lanes never push: only the integrator does, from C:/Antigravity/bc-integrate (docs/sprint.md). The sprint
# guard reads commands, not programs, so this also stops a push that a script or `node -e` runs in a lane's worktree.
case "$(basename "$(git rev-parse --show-toplevel)")" in
  bc-lane-*) printf >&2 '%s\n' "pre-push: no push from a sprint lane's worktree; only the integrator pushes (docs/sprint.md)"; exit 1 ;;
esac
command -v git-lfs >/dev/null 2>&1 || { printf >&2 "\n%s\n\n" "This repository is configured for Git LFS but 'git-lfs' was not found on your path. If you no longer wish to use Git LFS, remove this hook by deleting the 'pre-push' file in the hooks directory (set by 'core.hookspath'; usually '.git/hooks')."; exit 2; }
git lfs pre-push "$@"
