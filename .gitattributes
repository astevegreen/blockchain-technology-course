# Text files keep Linux (LF) line endings in every checkout, so shell scripts and Dockerfiles run on Linux.
* text=auto eol=lf
*.dat filter=lfs diff=lfs merge=lfs -text
dynamic-labs/bitcoin-forensics/forensics-lab-v3-instructor-dir/blocks/*.dat filter=lfs diff=lfs merge=lfs -text
# Sources merge entry by entry in a clone that sets merge.bib.driver (tools/sprint/bib-merge.mjs), so two branches
# that each add a source don't conflict; elsewhere git merges them line by line.
blockchain-course/lessons/references/*.bib merge=bib
