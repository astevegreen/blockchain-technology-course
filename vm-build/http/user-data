#cloud-config
hostname: ubuntu-lab
manage_etc_hosts: true

users:
  - default
  - name: student
    gecos: Student
    shell: /bin/bash
    groups: [adm, cdrom, dip, plugdev, sudo]
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: false
    plain_text_passwd: student

ssh_pwauth: true

chpasswd:
  list: |
    student:student
  expire: false

growpart:
  mode: auto
  devices: ["/"]

resize_rootfs: true

packages:
  - curl
  - wget
  - git
