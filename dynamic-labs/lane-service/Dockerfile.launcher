# lane-service for a student's own machine (the course launcher; docs/student-launcher-design.md).
# Build from dynamic-labs/ (the context needs ../bitcoin and ../bitcoin-forensics):
#   docker build -f lane-service/Dockerfile.launcher dynamic-labs
# Dockerfile.launcher.dockerignore lets in only what this file copies.
# Differences from Dockerfile, the classroom image:
# - LANE_MODE=student-local: one lane per lab, no class code, no host folders (labs/env_utils.py).
# - The bitcoin launcher compose file and the forensics chain are baked at the paths the classroom
#   bind-mounts, so labs/bitcoin.py runs unchanged. The build fails on a Git LFS pointer in place of
#   the chain, which is what a checkout without `git lfs pull` holds.
# - The instructor answers stay out: bitcoin_catalog.yaml loses its `solution` fields, and the
#   forensics lab.md (solution key) and cryptography/solution.md are not copied.
FROM python:3.12-slim-trixie

RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
    && ARCH=$(uname -m) \
    && curl -fsSL "https://download.docker.com/linux/static/stable/${ARCH}/docker-27.5.1.tgz" \
       | tar xz --strip-components=1 -C /usr/local/bin docker/docker \
    && mkdir -p /usr/local/libexec/docker/cli-plugins \
    && case "${ARCH}" in \
         x86_64)  COMPOSE_ARCH=x86_64 ;; \
         aarch64) COMPOSE_ARCH=aarch64 ;; \
         *)       echo "unsupported arch ${ARCH}"; exit 1 ;; \
       esac \
    && curl -fsSL "https://github.com/docker/compose/releases/download/v2.33.0/docker-compose-linux-${COMPOSE_ARCH}" \
         -o /usr/local/libexec/docker/cli-plugins/docker-compose \
    && chmod +x /usr/local/libexec/docker/cli-plugins/docker-compose \
    && apt-get purge -y curl && apt-get autoremove -y \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir flask requests markdown pyyaml

WORKDIR /app
COPY lane-service/app.py lane-service/exercises.py lane-service/generic_claims.py lane-service/generic_lanes.py \
     lane-service/instructor_auth.py lane-service/lab_blueprint.py lane-service/portal.py \
     lane-service/pre_stop_cleanup.py lane-service/progress.py /app/
COPY lane-service/admin.html lane-service/cryptography_admin.html lane-service/progress_summary.html \
     lane-service/wrapper.html /app/
COPY lane-service/labs/ /app/labs/
COPY lane-service/launcher_bake.py /tmp/launcher_bake.py
COPY bitcoin/docker-compose.launcher.yml /app/bitcoin-compose/docker-compose.launcher.yml
COPY bitcoin-forensics/forensics-lab-v3-instructor-dir/ /app/bitcoin-forensics/forensics-lab-v3-instructor-dir/

RUN python /tmp/launcher_bake.py /app/labs/bitcoin_catalog.yaml /app/bitcoin-forensics/forensics-lab-v3-instructor-dir \
    && rm /tmp/launcher_bake.py && mkdir -p /app/runtime

ENV LANE_MODE=student-local \
    CLASS_GATE=off \
    BITCOIN_COMPOSE_FILE=/app/bitcoin-compose/docker-compose.launcher.yml \
    BITCOIN_FORENSICS_V3_SNAPSHOT=/app/bitcoin-forensics/forensics-lab-v3-instructor-dir

EXPOSE 8090

CMD ["python", "app.py"]
