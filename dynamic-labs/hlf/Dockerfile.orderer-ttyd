# The Fabric orderer with ttyd and zellij (hlf-orderer-ttyd): Dockerfile.ttyd with FABRIC_ROLE=orderer, kept
# as its own file so the release builds the orderer image (tools/student_release.py builds each Dockerfile once).
# Change Dockerfile.ttyd and copy it here; dynamic-labs/tests/test_hlf_ttyd_dockerfiles.py checks the two match.
ARG FABRIC_VERSION=2.5.15
ARG FABRIC_ROLE=orderer

FROM hyperledger/fabric-${FABRIC_ROLE}:${FABRIC_VERSION}
# Empty: ttyd and zellij match the platform the image is built for (uname -m), so a multi-platform release
# build gets the right binaries for each. Set x86_64 or aarch64 to force one.
ARG TTYD_ARCH=

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends ncurses-term jq curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# ttyd and zellij are pinned to exact releases and checked against these sha256 sums, so an upstream
# release can't change the image. To bump: change the version and both sums (SHA256SUMS on the release).
ARG TTYD_VERSION=1.7.7
ARG TTYD_SHA256_X86_64=8a217c968aba172e0dbf3f34447218dc015bc4d5e59bf51db2f2cd12b7be4f55
ARG TTYD_SHA256_AARCH64=b38acadd89d1d396a0f5649aa52c539edbad07f4bc7348b27b4f4b7219dd4165
ARG ZELLIJ_VERSION=0.45.1
ARG ZELLIJ_SHA256_X86_64=40bcc2e03f5d5ae8e054e39f676081fe12ab70871506996ba595834c3718eefc
ARG ZELLIJ_SHA256_AARCH64=05f0802afadd53f8db9514e7cae53c9ae8432fed1b35b8294aa816ee3044a16b
RUN set -eu; \
    arch="${TTYD_ARCH:-$(uname -m)}"; \
    case "$arch" in \
      x86_64|amd64) arch="x86_64"; ttyd_sha="$TTYD_SHA256_X86_64"; zellij_sha="$ZELLIJ_SHA256_X86_64" ;; \
      aarch64|arm64) arch="aarch64"; ttyd_sha="$TTYD_SHA256_AARCH64"; zellij_sha="$ZELLIJ_SHA256_AARCH64" ;; \
      *) echo "Unsupported architecture for ttyd and zellij: $arch" >&2; exit 1 ;; \
    esac; \
    curl -fsSL "https://github.com/tsl0922/ttyd/releases/download/${TTYD_VERSION}/ttyd.${arch}" -o /usr/local/bin/ttyd; \
    curl -fsSL "https://github.com/zellij-org/zellij/releases/download/v${ZELLIJ_VERSION}/zellij-${arch}-unknown-linux-musl.tar.gz" -o /tmp/zellij.tar.gz; \
    echo "${ttyd_sha}  /usr/local/bin/ttyd" | sha256sum -c -; \
    echo "${zellij_sha}  /tmp/zellij.tar.gz" | sha256sum -c -; \
    chmod +x /usr/local/bin/ttyd; \
    tar xzf /tmp/zellij.tar.gz -C /usr/local/bin; rm /tmp/zellij.tar.gz; chmod +x /usr/local/bin/zellij

COPY zellij-config.kdl /etc/zellij/config.kdl

ENV ZELLIJ_CONFIG_DIR="/etc/zellij"

COPY scripts/hlf_ttyd_wrapper.sh /opt/hlf-scripts/hlf_ttyd_wrapper.sh
COPY scripts/hlf_peer_shell.sh   /opt/hlf-scripts/hlf_peer_shell.sh
COPY scripts/hlf_cli_helpers.sh  /opt/hlf-scripts/hlf_cli_helpers.sh
COPY scripts/hlf_bashrc_hook.sh /etc/hlf_bashrc_hook.sh

RUN if ! getent group hlf >/dev/null 2>&1; then groupadd --gid 1000 hlf; fi
RUN if ! id -u hlf >/dev/null 2>&1; then useradd --uid 1000 --gid 1000 --home-dir /home/student --shell /bin/bash --no-create-home hlf; fi
RUN mkdir -p /home/student /opt/student-home-seed /var/hyperledger/production
RUN chown -R 1000:1000 /home/student /var/hyperledger/production
RUN cp -a /home/student/. /opt/student-home-seed/ 2>/dev/null || true
RUN cat /etc/hlf_bashrc_hook.sh >> /etc/bash.bashrc
RUN chmod 755 /opt/hlf-scripts/*.sh
