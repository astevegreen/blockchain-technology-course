# Optional overrides for the lab launcher

# Where to place or find fabric-samples. If not present, ./lab.sh bootstrap will clone it here.
# FABRIC_SAMPLES_PATH=./fabric/fabric-samples

# Fabric channel name
HLF_CHANNEL=diplomas

# Chaincode name (default matches fabric-samples asset-transfer-basic examples)
HLF_CC_NAME=basic

# Lab instance identifier used for the tools container name.
# NOTE: Fabric test-network containers typically use fixed container_name values,
# which means running multiple instances on the same host concurrently may conflict.
HLF_INSTANCE_ID=student1

# Auto-start the Fabric network when hlf-runner boots.
HLF_AUTO_START_NETWORK=1

# Run `./lab.sh down` when hlf-runner receives SIGTERM/SIGINT so
# socket-spawned Fabric containers do not linger after compose down.
HLF_STOP_NETWORK_ON_EXIT=1

# Set to 1 to enable couchdb when bringing up the test network
HLF_USE_COUCHDB=1
