# Managed HLF CouchDB compose overlay.
# Rendered into fabric-samples/test-network/compose/compose-couch.yaml by lab.sh.
# Pinned to couchdb:3.4.2 for this release.

volumes:
  couchdb0_data:
  couchdb1_data:

networks:
  test:
    name: fabric_test
    external: true

services:
  couchdb0:
    container_name: couchdb0
    image: couchdb:3.4.2
    labels:
      service: hyperledger-fabric
    environment:
      - COUCHDB_USER=admin
      - COUCHDB_PASSWORD=adminpw
    ports:
      - "5984:5984"
    volumes:
      - couchdb0_data:/opt/couchdb/data
    networks:
      - test
    healthcheck:
      test: ["CMD-SHELL", "curl -sf http://admin:adminpw@localhost:5984/ || exit 1"]
      interval: 3s
      timeout: 5s
      retries: 20
      start_period: 5s

  peer0.cascadiastate.example.com:
    environment:
      - CORE_LEDGER_STATE_STATEDATABASE=CouchDB
      - CORE_LEDGER_STATE_COUCHDBCONFIG_COUCHDBADDRESS=couchdb0:5984
      - CORE_LEDGER_STATE_COUCHDBCONFIG_USERNAME=admin
      - CORE_LEDGER_STATE_COUCHDBCONFIG_PASSWORD=adminpw
    depends_on:
      couchdb0:
        condition: service_healthy

  couchdb1:
    container_name: couchdb1
    image: couchdb:3.4.2
    labels:
      service: hyperledger-fabric
    environment:
      - COUCHDB_USER=admin
      - COUCHDB_PASSWORD=adminpw
    ports:
      - "7984:5984"
    volumes:
      - couchdb1_data:/opt/couchdb/data
    networks:
      - test
    healthcheck:
      test: ["CMD-SHELL", "curl -sf http://admin:adminpw@localhost:5984/ || exit 1"]
      interval: 3s
      timeout: 5s
      retries: 20
      start_period: 5s

  peer0.chesapeakecanoe.example.com:
    environment:
      - CORE_LEDGER_STATE_STATEDATABASE=CouchDB
      - CORE_LEDGER_STATE_COUCHDBCONFIG_COUCHDBADDRESS=couchdb1:5984
      - CORE_LEDGER_STATE_COUCHDBCONFIG_USERNAME=admin
      - CORE_LEDGER_STATE_COUCHDBCONFIG_PASSWORD=adminpw
    depends_on:
      couchdb1:
        condition: service_healthy
