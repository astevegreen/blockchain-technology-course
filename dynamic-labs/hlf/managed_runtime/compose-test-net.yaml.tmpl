  # Org5 = Meridian Industries. Channel member with read-only narrative role:
  # the peer is provisioned identically to consortium peers (it must gossip,
  # fetch blocks, and participate in channel config validation), but the
  # channel-level endorsement policy in configtx excludes Org5MSP.peer, so
  # chaincode invocations never land here for endorsement.
  peer0.meridian.example.com:
    platform: __PLATFORM__
    container_name: peer0.meridian.example.com
    image: hlf-peer-ttyd:latest
