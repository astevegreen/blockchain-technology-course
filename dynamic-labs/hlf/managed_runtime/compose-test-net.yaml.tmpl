      - HLF_MSP_ID=Org1MSP
      - HLF_ORG_DOMAIN=cascadiastate.example.com
      - HLF_PEER_ADDRESS=peer0.cascadiastate.example.com:7051
      - HLF_PROMPT=org1
      - HLF_TITLE=Cascadia State University (peer0.cascadiastate.example.com)
      - HLF_ADMIN_USER=Admin@cascadiastate.example.com
    volumes:
      - ../organizations/peerOrganizations/cascadiastate.example.com/peers/peer0.cascadiastate.example.com:/etc/hyperledger/fabric
      - ./docker/peercfg:/etc/hyperledger/peercfg
      - peer0.cascadiastate.example.com:/var/hyperledger/production

      - ../organizations:/opt/hlf-orgs:ro
    pids_limit: 512
    tmpfs:
      - /tmp:size=128m,mode=1777
      - /run:size=16m
    working_dir: /root
    command: ["bash", "/opt/hlf-scripts/hlf_ttyd_wrapper.sh", "peer", "node", "start"]
    ports:
      - 7051:7051
      - 9444:9444
    networks:
      - test
      - instructor-term

