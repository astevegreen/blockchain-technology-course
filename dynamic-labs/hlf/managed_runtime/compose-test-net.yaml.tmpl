      - HLF_NODE_TYPE=consortium
      - HLF_MSP_ID=Org5MSP
      - HLF_ORG_DOMAIN=meridian.example.com
      - HLF_PEER_ADDRESS=peer0.meridian.example.com:15051
      - HLF_PROMPT=employer
      - HLF_TITLE=Meridian Industries (peer0.meridian.example.com) - read-only verifier
      - HLF_ADMIN_USER=Admin@meridian.example.com
    volumes:
      - ../organizations/peerOrganizations/meridian.example.com/peers/peer0.meridian.example.com:/etc/hyperledger/fabric
