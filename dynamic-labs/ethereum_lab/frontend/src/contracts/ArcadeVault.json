{
  "contractName": "ArcadeVault",
  "abi": [
    {
      "type": "event",
      "name": "ScoreSubmitted",
      "anonymous": false,
      "inputs": [
        { "name": "player", "type": "address", "indexed": true },
        { "name": "gameId", "type": "uint8", "indexed": true },
        { "name": "nonce", "type": "uint256", "indexed": true },
        { "name": "score", "type": "uint256", "indexed": false },
        { "name": "elapsedMs", "type": "uint256", "indexed": false },
        { "name": "timestamp", "type": "uint256", "indexed": false },
        { "name": "personalBest", "type": "bool", "indexed": false },
        { "name": "globalBest", "type": "bool", "indexed": false }
      ]
    },
    {
      "type": "event",
      "name": "SessionStarted",
      "anonymous": false,
      "inputs": [
        { "name": "player", "type": "address", "indexed": true },
        { "name": "gameId", "type": "uint8", "indexed": true },
        { "name": "nonce", "type": "uint256", "indexed": false },
        { "name": "timestamp", "type": "uint256", "indexed": false }
      ]
    },
    {
      "type": "function",
      "name": "MAX_SCORE",
      "stateMutability": "view",
      "inputs": [],
      "outputs": [{ "name": "", "type": "uint256" }]
    },
    {
      "type": "function",
      "name": "PLAY_COST",
      "stateMutability": "view",
      "inputs": [],
      "outputs": [{ "name": "", "type": "uint256" }]
    },
    {
      "type": "function",
      "name": "highScore",
      "stateMutability": "view",
      "inputs": [{ "name": "", "type": "uint8" }],
      "outputs": [
        { "name": "player", "type": "address" },
        { "name": "gameId", "type": "uint8" },
        { "name": "nonce", "type": "uint256" },
        { "name": "score", "type": "uint256" },
        { "name": "elapsedMs", "type": "uint256" },
        { "name": "timestamp", "type": "uint256" }
      ]
    },
    {
      "type": "function",
      "name": "personalBest",
      "stateMutability": "view",
      "inputs": [
        { "name": "", "type": "address" },
        { "name": "", "type": "uint8" }
      ],
      "outputs": [
        { "name": "player", "type": "address" },
        { "name": "gameId", "type": "uint8" },
        { "name": "nonce", "type": "uint256" },
        { "name": "score", "type": "uint256" },
        { "name": "elapsedMs", "type": "uint256" },
        { "name": "timestamp", "type": "uint256" }
      ]
    },
    {
      "type": "function",
      "name": "playGame",
      "stateMutability": "nonpayable",
      "inputs": [{ "name": "gameId", "type": "uint8" }],
      "outputs": []
    },
    {
      "type": "function",
      "name": "scoreSubmitted",
      "stateMutability": "view",
      "inputs": [
        { "name": "", "type": "address" },
        { "name": "", "type": "uint256" }
      ],
      "outputs": [{ "name": "", "type": "bool" }]
    },
    {
      "type": "function",
      "name": "sessionGame",
      "stateMutability": "view",
      "inputs": [
        { "name": "", "type": "address" },
        { "name": "", "type": "uint256" }
      ],
      "outputs": [{ "name": "", "type": "uint8" }]
    },
    {
      "type": "function",
      "name": "sessionNonce",
      "stateMutability": "view",
      "inputs": [{ "name": "", "type": "address" }],
      "outputs": [{ "name": "", "type": "uint256" }]
    },
    {
      "type": "function",
      "name": "submitScore",
      "stateMutability": "nonpayable",
      "inputs": [
        { "name": "gameId", "type": "uint8" },
        { "name": "nonce", "type": "uint256" },
        { "name": "score", "type": "uint256" },
        { "name": "elapsedMs", "type": "uint256" }
      ],
      "outputs": []
    },
    {
      "type": "function",
      "name": "token",
      "stateMutability": "view",
      "inputs": [],
      "outputs": [{ "name": "", "type": "address" }]
    }
  ]
