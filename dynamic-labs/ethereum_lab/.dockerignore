# Dependencies - will be installed fresh in container
node_modules
frontend/node_modules
scripts/cli-labs/standalone/node_modules

# Build outputs - will be rebuilt in container
frontend/dist
dist
build

# Development files
.git
.gitignore
.gitpod.yml
.gitpod.Dockerfile
.devcontainer
.vscode
.idea

# Documentation (except README)
*.md
!README.md
!scripts/cli-labs/standalone/README.md
!scripts/cli-labs/standalone/CONTRACT_BUILDER_GUIDE.md
!scripts/cli-labs/standalone/PLAYGROUND_TUTORIAL.md

# Instructor guides: the image serves docs/ to students, so keep both copies out
docs/instructor
frontend/public/docs/instructor

# Environment and secrets
.env
.env.*
student-accounts.json

# Cache and logs
*.log
npm-debug.log

# OS files
.DS_Store
Thumbs.db

# Test and coverage
coverage
.nyc_output
test

# GitHub
.github

# Keep checked-in Hardhat outputs available to the image build so the
# packaged VM doesn't need to compile contracts on first boot.
