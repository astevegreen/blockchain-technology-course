# Instructor surface for the cryptography lab. Serves .qmd files as
# plain text so browsers render them inline instead of downloading
# (nginx's default mime for .qmd is application/octet-stream). The
# types directive replaces the Content-Type header rewrite that the
# retired crypto-lab-router-1 used to apply.
FROM nginx:alpine

COPY instructor-nginx.conf /etc/nginx/conf.d/default.conf
COPY lab02_crypto_overview.qmd /usr/share/nginx/html/lab02_crypto_overview.qmd
