{
  "name": "blockchain_web",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "chain": "hardhat node --hostname 0.0.0.0",
    "deploy": "hardhat run scripts/deploy.js --network localhost",
    "deploy:beacon-lab": "npx hardhat run scripts/deploy-beacon-lab.js --network localhost",
    "beacon-lab": "node scripts/start-beacon-lab.js",
    "web": "cd frontend && npm run dev -- --host",
    "postinstall": "npm install --prefix frontend",
    "build": "npx hardhat compile && node scripts/sync-pos-abi.js && node scripts/copy-token-artifacts.js && npm run build --prefix frontend",
    "copy-token-artifacts": "node scripts/copy-token-artifacts.js",
    "test": "hardhat test",
    "test:pos": "hardhat test test/PoSScenarios.test.js",
    "test:contractlab": "hardhat test test/ContractLabScenarios.test.js",
    "verify": "node scripts/verify-connection.js",
    "lab1": "hardhat run scripts/cli-labs/1-explore-blockchain.js --network localhost",
    "lab2": "hardhat run scripts/cli-labs/2-sign-transaction.js --network localhost",
    "lab3": "hardhat run scripts/cli-labs/3-deploy-contract.js --network localhost",
    "lab4": "hardhat run scripts/cli-labs/4-query-data.js --network localhost",
    "lab5": "hardhat run scripts/cli-labs/5-validator-simulation.js --network localhost",
    "terminal": "node server/terminal-server.js",
    "lab-api": "node server/lab-api.js",
    "console": "hardhat console --network localhost",
    "prepare-classroom": "node scripts/prepare-classroom.js",
    "reset": "node scripts/reset-classroom.js",
    "reset:docker": "docker compose down -v && docker compose up --build",
    "harness:fullstack": "docker compose -f docker-compose.fullstack-local.yml up --build",
    "harness:fullstack:down": "docker compose -f docker-compose.fullstack-local.yml down",
    "harness:fullstack:reset": "docker compose -f docker-compose.fullstack-local.yml down -v && docker compose -f docker-compose.fullstack-local.yml up --build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.2.2",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "^3.0.13",
    "@nomicfoundation/hardhat-mocha": "^4.0.1",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.12",
    "chai": "^6.3.0",
    "ethers": "^6.17.0",
    "hardhat": "^3.21.2",
    "mocha": "^12.0.3"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "express": "^5.3.0",
    "node-pty": "^1.1.0",
    "solc": "0.8.38",
    "ws": "^8.22.1"
  },
  "overrides": {
    "tmp": "^0.2.7",
    "minimatch": "^11.0.1"
  }
}
